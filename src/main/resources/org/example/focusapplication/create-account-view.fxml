<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.focusapplication.CreateAccountController"
            minWidth="420.0" minHeight="500.0" prefWidth="420.0" prefHeight="500.0">
    <center>
        <VBox alignment="CENTER" spacing="16.0" style="-fx-background-color: linear-gradient(to bottom, #111827, #1f2937); -fx-padding: 32 36 32 36;">
            <Label text="Create Account" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label text="Set up your focus profile" style="-fx-font-size: 14px; -fx-text-fill: #d1d5db;" />
            <VBox spacing="10.0" maxWidth="300.0">
                <Label text="Username" style="-fx-text-fill: white;" />
                <TextField fx:id="usernameField" promptText="Choose a username" />
                <Label text="Password" style="-fx-text-fill: white;" />
                <PasswordField fx:id="passwordField" promptText="Choose a password" />
                <Label text="Confirm Password" style="-fx-text-fill: white;" />
                <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" />
            </VBox>
            <Button text="Create Account" onAction="#handleCreateAccount" maxWidth="300.0" defaultButton="true" style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 16 10 16;" />
            <Hyperlink text="Back to login" onAction="#onBackToLoginClicked" style="-fx-text-fill: #bfdbfe; -fx-font-size: 13px;" />
            <Label fx:id="statusLabel" text="" wrapText="true" style="-fx-text-fill: #fbbf24; -fx-font-size: 12px;" />
        </VBox>
    </center>
</BorderPane>
