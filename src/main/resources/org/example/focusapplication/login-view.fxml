<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.focusapplication.FocusController"
            minWidth="420.0" minHeight="500.0" prefWidth="420.0" prefHeight="500.0">
    <center>
        <VBox alignment="CENTER" spacing="16.0" style="-fx-background-color: linear-gradient(to bottom, #1f2937, #111827); -fx-padding: 32 36 32 36;">
            <Label text="Focus Application" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label text="Sign in to continue" style="-fx-font-size: 14px; -fx-text-fill: #d1d5db;" />
            <VBox spacing="10.0" maxWidth="300.0">
                <Label text="Username" style="-fx-text-fill: white;" />
                <TextField fx:id="usernameField" promptText="Enter your username" />
                <Label text="Password" style="-fx-text-fill: white;" />
                <PasswordField fx:id="passwordField" promptText="Enter your password" />
            </VBox>
            <Button text="Log In" onAction="#handleLogin" maxWidth="300.0" defaultButton="true" style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 16 10 16;" />
            <Hyperlink text="Create an account" onAction="#onCreateAccountClicked" style="-fx-text-fill: #c4b5fd; -fx-font-size: 13px;" />
            <Label fx:id="statusLabel" text="" wrapText="true" style="-fx-text-fill: #fbbf24; -fx-font-size: 12px;" />
        </VBox>
    </center>
</BorderPane>
